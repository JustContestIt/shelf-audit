   "name": "Буфер: протухло → error"
  },
  {
   "parameters": {
    "jsCode": "// одно сообщение на чат, а не на каждое потерянное фото\nconst rows = $input.all().map(i => i.json).filter(r => r && r.row_key);\nif (!rows.length) return [];\n\nconst byChat = {};\nfor (const r of rows) {\n  const c = String(r.chat_id || '');\n  if (!c) continue;\n  (byChat[c] = byChat[c] || []).push(r);\n}\n\nreturn Object.keys(byChat).map(chat_id => ({ json: {\n  chat_id: Number(chat_id),\n  count: byChat[chat_id].length,\n  text: '⚠️ ' + byChat[chat_id].length + ' фото не удалось обработать (обработка прервалась). '\n        + 'Пришлите их, пожалуйста, ещё раз.',\n} }));"
   },
