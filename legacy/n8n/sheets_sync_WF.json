  {
   "parameters": {
    "jsCode": "// Реплика листа Catalog в Data Table brand_catalog.\n// Валидация ДО очистки: если лист пуст/сломан — падаем ЗДЕСЬ, реплика остаётся вчерашней\n// (URI Files API живут 48 ч, WF-3 обновляет их раз в сутки в 05:00 — запас есть).\nconst rows = $input.all().map(i => i.json).filter(r => r && String(r.key || '').trim());\nconst usable = rows.filter(r => r.file_url && r.canon_name);\nif (usable.length < 20) {\n  throw new Error('Sheets Sync: в Catalog только ' + usable.length + ' пригодных эталонов (<20) — реплику не трогаю, проверь WF-3');\n}\nreturn [{ json: { rows: rows.map(r => ({\n  key:        String(r.key ?? ''),\n  brand:      String(r.brand ?? ''),\n  canon_name: String(r.canon_name ?? ''),\n  variant:    String(r.variant ?? ''),\n  file_url:   String(r.file_url ?? ''),\n  mime_type:  String(r.mime_type ?? ''),\n})), count: rows.length } }];"
   },
