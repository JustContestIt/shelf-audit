   "parameters": {
    "jsCode": "// ISO UTC: сравнение строк = сравнение времени (конвенция как в photo_buffer).\nconst now = Date.now();\nreturn [{ json: {\n  now_iso:           new Date(now).toISOString(),\n  hold_before:       new Date(now - 24*3600*1000).toISOString(),      // незакрытые строки младше суток ждут следующего синка\n  purge_rows_before: new Date(now - 14*24*3600*1000).toISOString(),   // report_rows: 14 дней после выгрузки\n  purge_logs_before: new Date(now - 30*24*3600*1000).toISOString(),   // wf_logs: 30 дней\n} }];"
