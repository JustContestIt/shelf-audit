  {
   "parameters": {
    "jsCode": "const th = $('Пороги выгрузки').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.report_id);\n// строка уезжает, когда статус финальный; «на_проверке» держим сутки, чтобы успел приехать вердикт агента\nconst ready = rows.filter(r =>\n  (r.status && r.status !== 'на_проверке') || String(r.created_at || '') < th.hold_before);\nreturn ready.map(r => ({ json: {\n  report_id: r.report_id ?? '',          report_date: r.report_date ?? '',\n  route_code: r.route_code ?? '',        store_code: r.store_code ?? '',\n  store_name: r.store_name ?? '',        product_name: r.product_name ?? '',\n  product_subtype: r.product_subtype ?? '', package_format: r.package_format ?? '',\n  shelf_index: r.shelf_index ?? '',      position: r.position ?? '',\n  front_facing_count: r.front_facing_count ?? '', status: r.status ?? '',\n} }));"
   },
