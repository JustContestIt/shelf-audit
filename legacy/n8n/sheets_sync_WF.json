  {
   "parameters": {
    "jsCode": "const th = $('Пороги выгрузки').first().json;\nconst disp = iso => { const d = new Date(new Date(iso).getTime() + 5*3600*1000);\n  return isNaN(d) ? '' : d.toISOString().replace('T', ' ').slice(0, 19); };  // формат листа Logs, UTC+5\nconst rows = $input.all().map(i => i.json).filter(r => r && r.run_id);\n// Started/Processed = прогон ещё идёт; держим сутки, потом выгружаем как есть — упавшие прогоны видно в таблице\nconst ready = rows.filter(r =>\n  !['Started', 'Processed'].includes(String(r.status)) || String(r.created_at || '') < th.hold_before);\nreturn ready.map(r => ({ json: {\n  run_id: r.run_id ?? '', chat_id: r.chat_id ?? '', status: r.status ?? '',\n  confidence: r.confidence ?? '', notes_google: r.notes_google ?? '', notes_user: r.notes_user ?? '',\n  created_disp: disp(r.created_at), updated_disp: disp(r.updated_at),\n} }));"
