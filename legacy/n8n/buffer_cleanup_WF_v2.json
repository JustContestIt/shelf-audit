   "alwaysOutputData": true,
   "notesInFlow": false,
   "notes": "Лимит Data Tables — 50 МБ на инстанс. Чистим по системной createdAt, независимо от статуса."
  },
  {
   "parameters": {
    "jsCode": "const stale = (() => { try { return $('Зависшие processing').all().filter(i => i.json && i.json.row_key).length; } catch (e) { return 0; } })();\nconst purged = $input.all().filter(i => i.json && i.json.row_key).length;\nreturn [{ json: { stale_to_error: stale, purged_rows: purged, at: $('Пороги').first().json.now_iso } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
