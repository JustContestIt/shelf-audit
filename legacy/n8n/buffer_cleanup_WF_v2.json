  {
   "parameters": {
    "jsCode": "// tzdata в n8n нет — считаем в UTC. Пороги уходят в фильтр по системной колонке createdAt\n// (тип date): нода сама превращает ISO-строку в Date, сравнение хронологическое.\nconst STUCK_MIN = 10;   // processing дольше этого = прогон умер (рестарт n8n, #20)\nconst KEEP_DAYS = 7;    // глубина хранения буфера (лимит Data Tables 50 МБ, #5.3)\nreturn [{ json: {\n  stuck_before: new Date(Date.now() - STUCK_MIN * 60 * 1000).toISOString(),\n  purge_before: new Date(Date.now() - KEEP_DAYS * 24 * 3600 * 1000).toISOString(),\n  now_iso: new Date().toISOString(),\n} }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    416
   ],
   "id": "6be4e33d-b358-4ad5-aefb-b084c32db890",
   "name": "Пороги"
  },
  {
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "value": "photo_buffer",
     "mode": "name"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "status",
       "condition": "eq",
       "keyValue": "processing"
      },
      {
       "keyName": "createdAt",
       "condition": "lt",
       "keyValue": "={{ $json.stuck_before }}"
      }
     ]
    },
    "returnAll": true
   },
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1,
   "position": [
