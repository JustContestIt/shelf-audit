# Copy to .env and fill in. NEVER commit .env (gitleaks runs in pre-commit and CI).
# All keys below must be NEW ones issued for this project — not the production n8n ones.

# --- LLM ---------------------------------------------------------------
GEMINI_API_KEY=                 # separate key for the diploma project (Google AI Studio, Tier 1)
# comma-free JSON lists for pydantic-settings:
DETECT_MODELS=["gemini-3.5-flash","gemini-3-flash-preview"]
VERIFY_MODELS=["gemini-3.5-flash","gemini-3-flash-preview"]
OPENROUTER_API_KEY=             # optional fallback (re-issued; the old openrouter_key.txt is compromised)
OPENROUTER_MODEL=               # e.g. openai/gpt-5.6 ; empty = not in the fallback chain
LLM_MODE=live                   # live | record (live + save answers to evals/cache) | replay (recorded answers only)

# --- pipeline knobs (see evals/configs/*.yaml for experiment presets) ---
PROMPT_DETECT=detect_v7.5
PROMPT_VERIFY=verify_v9
PASS2_MODE=gate                 # always | gate | check (RAG ours/foreign check, no LLM pass 2) | off
PASS2_REFS=topk                 # topk (RAG) | all (46 refs, as in n8n)
RAG_TOP_K=3
TEMPERATURE=0

# --- storage -----------------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://shelf:change-me@localhost:5432/shelf

# --- observability -----------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shelf-audit

# --- Telegram bot (NEW bot from @BotFather, not the production one) -----
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://localhost:8000
API_TOKEN=                      # shared secret bot/mcp -> api; empty = open API (dev only)

# --- Google Sheets export (optional, test spreadsheet only) -------------
SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
